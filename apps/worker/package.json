    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@drago/core": "workspace:*",
    "@drago/database": "workspace:*",
    "@drago/shared": "workspace:*",
    "@types/node": "^22.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
