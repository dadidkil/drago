# ═══════════════════════════════════════════════════════════════════════
#  ТОП «Драго» — переменные окружения.
#  Скопируйте в .env (НЕ коммитить!) и заполните.
#  Сгенерировать все секреты разом: ./infrastructure/scripts/gen-secrets.sh
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=production
DOMAIN=dragotop.ru
APP_URL=https://dragotop.ru

# Кто принимает 80/443:
#   caddy       — чистый сервер: Caddy из docker-compose получает сертификаты сам
#   ispmanager  — сервер с панелью ISPmanager: её nginx проксирует на 127.0.0.1:WEB_PORT
REVERSE_PROXY=ispmanager
# Порты только на 127.0.0.1. 3000 часто занят другими Node.js-сайтами; если выбранный порт
# занят чужим процессом, make deploy сам возьмёт свободный и запишет его сюда.
WEB_PORT=3100
VK_BOT_PORT=3102
# Email для Let's Encrypt (уведомления об истечении сертификатов)
ACME_EMAIL=admin@dragotop.ru

# ── PostgreSQL (доступен только внутри Docker-сети) ─────────────────────
POSTGRES_USER=drago
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=drago
DATABASE_URL=postgresql://drago:__POSTGRES_PASSWORD__@postgres:5432/drago?schema=public
DATABASE_POOL_SIZE=10

# ── Redis (rate limiting; только внутри Docker-сети) ────────────────────
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379/0

# ── Криптография ─────────────────────────────────────────────────────────
# 32 байта в base64: openssl rand -base64 32
# Шифрует TOTP-секреты и временные пароли почтовых ящиков. НЕ МЕНЯТЬ после запуска.
APP_ENCRYPTION_KEY=__GENERATE__

# ── Файлы ────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads

# ── Исходящая почта (приглашения, сброс пароля, уведомления) ────────────
# Пусто → письма пишутся в лог (только для разработки).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ТОП «Драго» <noreply@dragotop.ru>"

# ── Telegram-бот (токен от @BotFather) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── VK-бот сообщества (Callback API) ────────────────────────────────────
VK_GROUP_ID=
VK_ACCESS_TOKEN=
# Секретный ключ Callback API (Управление → Работа с API → Callback API)
VK_CALLBACK_SECRET=__GENERATE__
# Строка, которую должен вернуть сервер при подтверждении адреса
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199

# ── Корпоративные ящики @dragotop.ru ────────────────────────────────────
# ispmanager — ящики создаются автоматически через API панели ISPmanager (почта на этом же сервере)
# manual     — ящики создаются вручную у провайдера, система только ведёт учёт
# stalwart   — ящики создаются автоматически через API Stalwart Mail Server
MAIL_PROVIDER=manual
MAIL_DOMAIN=dragotop.ru
# API ISPmanager (для MAIL_PROVIDER=ispmanager). Пользователь панели — владелец почтового домена, НЕ root.
ISPMANAGER_URL=https://host.docker.internal:1500
ISPMANAGER_USER=
ISPMANAGER_PASSWORD=
# Панель на :1500 обычно с самоподписанным сертификатом: при обращении через host.docker.internal
# проверку можно отключить (трафик не покидает сервер). При валидном сертификате — true.
ISPMANAGER_TLS_VERIFY=false
STALWART_URL=http://stalwart:8080
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=
